# Runtime connection. For Neon, use the pooled connection string here.
DATABASE_URL="postgresql://connectx:change-this-password@localhost:5432/connectx?schema=public"

# Direct connection used by Prisma Migrate. For local PostgreSQL, this can match DATABASE_URL.
# For Neon, use the direct (non-pooler) connection string here.
DIRECT_URL="postgresql://connectx:change-this-password@localhost:5432/connectx?schema=public"

# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-this-with-a-random-secret-at-least-32-characters"

POSTGRES_PASSWORD="change-this-password"

PORT=4000
WEB_ORIGIN="http://127.0.0.1:5173,http://localhost:5173"
# Optional: set this before building if your hosted API has a public URL.
VITE_API_URL="http://127.0.0.1:4000"